{
  "@context": {
    "@vocab": "http://www.w3.org/ns/shacl#",
    "adms": "http://www.w3.org/ns/adms#",
    "classes": {
      "@container": "@id",
      "@id": "dcterms:hasPart"
    },
    "closed": {
      "@type": "xsd:boolean"
    },
    "datatype": {
      "@type": "@id"
    },
    "dcat": "http://www.w3.org/ns/dcat#",
    "dcterms": "http://purl.org/dc/terms/",
    "description": {
      "@container": "@language",
      "@id": "dcterms:description"
    },
    "enums": {
      "@container": "@id",
      "@id": "dcterms:hasPart"
    },
    "imports": {
      "@id": "owl:imports",
      "@type": "@id"
    },
    "in": {
      "@container": "@list",
      "@type": "@id"
    },
    "node": {
      "@type": "@id"
    },
    "nodeKind": {
      "@type": "@id"
    },
    "or": {
      "@container": "@list",
      "@type": "@id"
    },
    "owl": "http://www.w3.org/2002/07/owl#",
    "path": {
      "@type": "@id"
    },
    "property": {
      "@container": "@index",
      "@context": {
        "description": {
          "@id": "sh:description",
          "@type": "xsd:string"
        },
        "name": {
          "@id": "sh:name",
          "@type": "xsd:string"
        }
      },
      "@index": "path"
    },
    "publisher": {
      "@id": "dcterms:publisher"
    },
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "sh": "http://www.w3.org/ns/shacl#",
    "title": {
      "@container": "@language",
      "@id": "dcterms:title"
    },
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@id": "https://modellen.netbeheernederland.nl/nbnl-dataset/0.1/metadata.shacl.jsonld",
  "@type": [
    "dcat:Dataset",
    "adms:Asset",
    "sh:ShapesGraph",
    "owl:Ontology"
  ],
  "classes": {
    "dcat:Dataset": {
      "@type": [
        "rdfs:Class",
        "sh:NodeShape"
      ],
      "property": {
        "dcterms:issued": {
          "datatype": "xsd:dateTime",
          "minCount": 1,
          "maxCount": 1,
          "name": "issued"
        },
        "dcterms:publisher": {
          "minCount": 1,
          "maxCount": 1,
          "name": "publisher",
          "node": "https://modellen.netbeheernederland.nl/waardelijsten/marktpartijen#marktpartijenShape"
        },
        "dcterms:references": {
          "name": "references",
          "or": [
            {
              "datatype": "xsd:anyURI"
            },
            {
              "nodeKind": "sh:BlankNodeOrIRI"
            }
          ]
        },
        "dcterms:title": {
          "maxCount": 1,
          "name": "title",
          "or": [
            {
              "datatype": "rdf:langString"
            },
            {
              "datatype": "xsd:string"
            }
          ]
        }
      }
    }
  },
  "imports": [
    "https://modellen.netbeheernederland.nl/waardelijsten/marktpartijen/0.1"
  ]
}
